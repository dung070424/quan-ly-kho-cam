.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
*.sublime-workspace
*.sublime-project

# Node.js Dependencies (Recursive)
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.log

# Angular & Frontend Development (Recursive)
**/.angular/
**/dist/
**/tmp/
**/out-tsc/
**/bazel-out/
**/coverage/
testem.log
/typings

# Build Outputs & Logs
logs
*.log
**/build_output.txt

# Secrets, Environment Variables & Configs
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
